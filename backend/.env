# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/supplychain

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# JWT Secret (generate a strong secret for production)
JWT_SECRET=your_super_secret_jwt_key_here

# Free Map APIs Configuration
# OpenRouteService API (free tier: 2000 requests/day)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# Alternative: MapBox (free tier: 50,000 requests/month)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Nominatim settings (OpenStreetMap geocoding - completely free)
NOMINATIM_USER_AGENT=Supply-Chain-Management-System/1.0
NOMINATIM_EMAIL=your_email@domain.com

# OSRM Demo Server (free but rate limited)
OSRM_SERVER_URL=http://router.project-osrm.org

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WEBSOCKET_ORIGINS=http://localhost:3000,https://yourdomain.com

NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=http://localhost:5000

